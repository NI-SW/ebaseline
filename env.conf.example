{
  "database": {
    "host": "192.168.34.65",
    "port": 3306,
    "user": "root",
    "password": "Info@1234",
    "schema": "ebase"
  },
  "server": {
    "host": "0.0.0.0",
    "port": 8080,
    "debug": false
  },
  "mcp": {
    "enabled": true,
    "host": "127.0.0.1",
    "port": 8081,
    "path": "/mcp",
    "auth_token": "",
    "readonly_token": "",
    "token_file": "runtime/mcp_token",
    "allow_unauthenticated": false,
    "allowed_hosts": [],
    "allowed_origins": []
  },
  "workspace": {
    "terminal_enabled": true,
    "terminal_min_privilege": 1,
    "allow_root_execution": false
  },
  "security": {
    "mask_group_secrets": true,
    "mask_placeholder": "********"
  },
  "auth": {
    "secret_key": "change-me-to-a-random-secret",
    "token_expire_minutes": 1440,
    "allow_register": true,
    "allow_init_admin": false,
    "initial_admin_password": ""
  },
  "agent": {
    "default_timeout": 300,
    "max_follow_ups": 3,
    "autonomy_directive": true
  },
  "scripts": {
    "base_dir": "./scripts",
    "shell": "/bin/bash"
  }
}
